  "template": {
    "title": "Derinlik kamerasıyla yükseklik ve hacim ölçümü",
    "categories": [
      "Ölçüm",
      "Kalite kontrol"
    ],
    "description": "3B derinlik görüntüsünde zemin düzlemini bulur, kutunun zeminden yüksekliğini (mm) ve hacmini (cm³) ölçer, ikisini de tolerans içinde mi diye kontrol eder. Kamera olmadan yapay derinlik sahnesiyle çalışır; gerçek RealSense / Orbbec kamera için kaynak bloğunu Derinlik Kamerası ile değiştirin.",
    "questions": [
      {
        "id": "yukseklik",
        "label": "Nominal yükseklik (mm)",
        "kind": "float",
        "default": 40,
        "min": 0,
        "max": 10000,
        "targets": [
          {
            "node": "yukseklik_tol",
            "param": "nominal"
          }
        ]
      },
      {
        "id": "tol",
        "label": "Yükseklik toleransı ± (mm)",
        "kind": "float",
        "default": 2,
        "min": 0,
        "max": 1000,
        "targets": [
          {
            "node": "yukseklik_tol",
            "param": "low",
            "expr": "yukseklik - tol"
          },
          {
            "node": "yukseklik_tol",
            "param": "high",
            "expr": "yukseklik + tol"
          }
        ]
      },
      {
        "id": "hacim",
        "label": "Nominal hacim (cm³)",
        "kind": "float",
        "default": 280,
        "min": 0,
        "max": 1000000,
        "targets": [
          {
            "node": "hacim_tol",
            "param": "nominal"
          }
        ]
      },
      {
        "id": "hacim_tol",
        "label": "Hacim toleransı ± (%)",
        "kind": "float",
        "default": 3,
        "min": 0,
        "max": 100,
        "targets": [
          {
            "node": "hacim_tol",
            "param": "low",
            "expr": "hacim - hacim * hacim_tol / 100"
          },
          {
            "node": "hacim_tol",
            "param": "high",
            "expr": "hacim + hacim * hacim_tol / 100"
          }
        ]
      },
      {
        "id": "degisim",
        "label": "Deneme: kutu yüksekliği her parçada ± kaç mm oynasın",
        "kind": "float",
        "default": 3,
        "min": 0,
        "max": 100,
        "targets": [
          {
            "node": "sahne",
            "param": "vary"
          }
        ]
      }
    ]
  }
