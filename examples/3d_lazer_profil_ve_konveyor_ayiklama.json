      "dst_port": "reject_cmd"
    },
    {
      "src": "lazer",
      "src_port": "heightmap_image",
      "dst": "onizleme",
      "dst_port": "image"
    }
  ],
  "template": {
    "title": "3D Lazer Profilometre + Yüksek Hızlı Pnömatik Ayıklama",
    "categories": [
      "Ölçüm",
      "PLC",
      "Kalite kontrol"
    ],
    "description": "3D lazer triangülasyonu ile parçanın Z yüksekliğini ve düzlemselliğini ölçer; tolerans dışı parçayı konveyör hızına göre hesaplayarak tam hava nozülü önünde hatta duraksama olmadan fırlatır.",
    "questions": [
      {
        "id": "kaynak",
        "label": "Görüntü kaynağı",
        "kind": "source",
        "default": "Örnek resimler",
        "help": "Önce test deseniyle deneyin; sonra kameranızı seçin.",
        "targets": [
          {
            "node": "kaynak"
          }
        ]
      },
      {
        "id": "hedef_h",
        "label": "Hedef Yükseklik (mm)",
        "kind": "float",
        "default": 5.0,
        "min": 0.0,
        "max": 100.0,
        "targets": [
          {
            "node": "lazer",
            "param": "target_height_mm"
          }
        ]
      },
      {
        "id": "bant_hizi",
        "label": "Konveyör Bant Hızı (m/dk)",
        "kind": "float",
        "default": 30.0,
        "min": 1.0,
        "max": 200.0,
        "targets": [
          {
            "node": "sorter",
            "param": "conveyor_speed_m_per_min"
          }
        ]
      }
    ]
  }
