    {
      "id": "plc",
      "type": "VirtualPLCSimulator",
      "pos": [580.0, 110.0],
      "values": {
        "parts_per_minute": 30.0
      }
    },
    {
      "id": "onizleme",
      "type": "Preview",
      "pos": [880.0, 0.0],
      "values": {
        "overlay": ""
      }
    }
  ],
  "connections": [
    {
      "src": "kaynak",
      "src_port": "image",
      "dst": "lazer",
      "dst_port": "image"
    },
    {
      "src": "kaynak",
      "src_port": "image",
      "dst": "sorter",
      "dst_port": "image"
    },
    {
      "src": "lazer",
      "src_port": "is_in_spec",
      "dst": "sorter",
      "dst_port": "part_detected"
    },
    {
      "src": "sorter",
      "src_port": "ejector_blow_signal",
