{
  "format": "visionflow",
  "version": 1,
  "nodes": [
    {
      "id": "kaynak",
      "type": "ImageFolder",
      "pos": [
        0.0,
        0.0
      ],
      "values": {
        "folder": "examples/ornek_veri/sablonlar/renk",
        "loop": true,
        "delay": 0.6,
        "recursive": false
      }
    },
    {
      "id": "renk",
      "type": "ColorSort",
      "pos": [
        280.0,
        0.0
      ],
      "values": {
        "roi": "170,110,140,140",
        "classes": "kırmızı=#d22828; yeşil=#28a53c; mavi=#285ac8; sarı=#e1d228",
        "tolerance": 35.0,
        "stat": "baskın renk",
        "background": "koyu zemini yok say",
        "bg_level": 80,
        "unknown": "bilinmiyor"
      }
    },
    {
      "id": "onizleme",
      "type": "Preview",
      "pos": [
        600.0,
        -120.0
      ],
      "values": {
        "overlay": ""
      }
    },
    {
      "id": "sinif",
      "type": "ShowValue",
      "pos": [
        600.0,
        60.0
      ],
      "values": {
        "prefix": "Renk: ",
        "log": false
      }
    },
    {
      "id": "plc",
      "type": "ModbusWrite",
      "pos": [
        600.0,
        200.0
      ],
      "values": {
        "host": "192.168.0.10",
        "port": 502,
        "unit": 1,
        "kind": "register",
        "address": 10
      },
      "disabled": true
    }
  ],
  "connections": [
    {
      "src": "kaynak",
      "src_port": "image",
      "dst": "renk",
      "dst_port": "image"
    },
    {
      "src": "renk",
      "src_port": "image",
      "dst": "onizleme",
      "dst_port": "image"
    },
    {
      "src": "renk",
      "src_port": "class",
      "dst": "sinif",
      "dst_port": "value"
    },
    {
      "src": "renk",
      "src_port": "index",
      "dst": "plc",
      "dst_port": "value"
    }
  ],
  "template": {
    "title": "Renk ile ayıklama + PLC çıkışı",
    "categories": [
      "Kalite kontrol",
      "PLC",
      "Otomasyon"
    ],
    "description": "Banttaki parçanın rengini adlandırılmış renklerden birine atar; renk numarasını (1, 2, 3…; 0 = bilinmiyor) PLC register'ına yazarak ayıklama kapısını sürer.",
    "questions": [
      {
        "id": "kaynak",
        "label": "Görüntü kaynağı",
        "kind": "source",
        "default": "Örnek resimler",
        "help": "Önce örnek resimlerle deneyin; sonra kameranızı seçin.",
        "targets": [
          {
            "node": "kaynak"
          }
        ]
      },
      {
        "id": "renkler",
        "label": "Renkler (ad=#rrggbb; …)",
        "kind": "str",
        "default": "kırmızı=#d22828; yeşil=#28a53c; mavi=#285ac8; sarı=#e1d228",
        "targets": [
          {
            "node": "renk",
            "param": "classes"
          }
        ]
      },
      {
        "id": "tolerans",
        "label": "Renk toleransı (ΔE)",
        "kind": "float",
        "default": 35,
        "min": 1,
        "max": 300,
        "targets": [
          {
            "node": "renk",
            "param": "tolerance"
          }
        ]
      },
      {
        "id": "plc",
        "label": "Sonucu PLC'ye yaz (Modbus TCP)",
        "kind": "bool",
        "default": false,
        "targets": [
          {
            "node": "plc",
            "enabled": true
          }
        ]
      },
      {
        "id": "plc_ip",
        "label": "PLC IP adresi",
        "kind": "str",
        "default": "192.168.0.10",
        "targets": [
          {
            "node": "plc",
            "param": "host"
          }
        ]
      },
      {
        "id": "plc_adres",
        "label": "Register adresi",
        "kind": "int",
        "default": 0,
        "min": 0,
        "max": 65535,
        "targets": [
          {
            "node": "plc",
            "param": "address"
          }
        ]
      }
    ]
  }
}
